{
  "openapi": "3.0.0",
  "info": {
    "title": "Currency API",
    "version": "1.0.0",
    "description": "API для управління валютами та курсами обміну."
  },
  "paths": {
    "/api/currencies": {
      "post": {
        "summary": "Створення валюти",
        "description": "Додає нову валюту з вказаною назвою та країною.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Назва валюти."
          },
          {
            "name": "country",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Країна, до якої відноситься валюта."
          }
        ],
        "responses": {
          "201": {
            "description": "Валюта створена.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          },
          "400": {
            "description": "Неправильний запит. Помилка у введених даних."
          }
        }
      }
    },
    "/api/currencies/{id}": {
      "get": {
        "summary": "Отримання валюти за ID",
        "description": "Повертає інформацію про валюту за вказаним ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Унікальний ідентифікатор валюти."
          }
        ],
        "responses": {
          "200": {
            "description": "Інформація про валюту.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Currency"
                }
              }
            }
          },
          "404": {
            "description": "Валюта не знайдена."
          }
        }
      },
      "put": {
        "summary": "Оновлення валюти",
        "description": "Оновлює інформацію про валюту за ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Унікальний ідентифікатор валюти."
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Нова назва валюти."
          },
          {
            "name": "country",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Нова країна валюти."
          }
        ],
        "responses": {
          "200": {
            "description": "Оновлена валюта.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Currency"
                }
              }
            }
          },
          "400": {
            "description": "Неправильний запит. Помилка у введених даних."
          }
        }
      },
      "delete": {
        "summary": "Видалення валюти",
        "description": "Видаляє валюту за ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Унікальний ідентифікатор валюти."
          }
        ],
        "responses": {
          "204": {
            "description": "Валюта успішно видалена."
          },
          "400": {
            "description": "Неправильний запит. Помилка у введених даних."
          }
        }
      }
    },
    "/api/currenciesByCountry": {
      "get": {
        "summary": "Отримання валют за країною",
        "description": "Повертає список валют для вказаної країни.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Країна для пошуку валют."
          }
        ],
        "responses": {
          "200": {
            "description": "Список валют.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Currency"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Країна не знайдена."
          }
        }
      }
    },
    "/api/rates": {
      "post": {
        "summary": "Створення курсу обміну",
        "description": "Додає новий курс обміну для вказаної валюти.",
        "parameters": [
          {
            "name": "value",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "description": "Значення курсу обміну."
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Дата курсу обміну."
          },
          {
            "name": "currencyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID валюти."
          }
        ],
        "responses": {
          "201": {
            "description": "Курс обміну створено.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          },
          "400": {
            "description": "Неправильний запит. Помилка у введених даних."
          }
        }
      }
    },
    "/api/rates/{id}": {
      "get": {
        "summary": "Отримання курсу обміну за ID",
        "description": "Повертає курс обміну за вказаним ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Унікальний ідентифікатор курсу обміну."
          }
        ],
        "responses": {
          "200": {
            "description": "Інформація про курс обміну.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRate"
                }
              }
            }
          },
          "404": {
            "description": "Курс обміну не знайдено."
          }
        }
      },
      "put": {
        "summary": "Оновлення курсу обміну",
        "description": "Оновлює інформацію про курс обміну за вказаним ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Унікальний ідентифікатор курсу обміну."
          },
          {
            "name": "rate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "description": "Нове значення курсу обміну."
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Нова дата курсу обміну."
          }
        ],
        "responses": {
          "200": {
            "description": "Оновлений курс обміну.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRate"
                }
              }
            }
          },
          "400": {
            "description": "Неправильний запит. Помилка у введених даних."
          }
        }
      },
      "delete": {
        "summary": "Видалення курсу обміну",
        "description": "Видаляє курс обміну за вказаним ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Унікальний ідентифікатор курсу обміну."
          }
        ],
        "responses": {
          "204": {
            "description": "Курс обміну успішно видалений."
          },
          "400": {
            "description": "Неправильний запит. Помилка у введених даних."
          }
        }
      }
    },
    "/api/ratesByCurrencyId": {
      "get": {
        "summary": "Отримання курсів обміну за валюту",
        "description": "Повертає список курсів обміну для вказаної валюти.",
        "parameters": [
          {
            "name": "currencyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID валюти для пошуку курсів."
          }
        ],
        "responses": {
          "200": {
            "description": "Список курсів обміну.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExchangeRate"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Курси для вказаної валюти не знайдено."
          }
        }
      }
    },
    "/api/ratesByDate": {
      "get": {
        "summary": "Отримання курсів обміну за дату",
        "description": "Повертає список курсів обміну для вказаної дати.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список курсів обміну за вказану дату.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExchangeRate"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Курси обміну для вказаної дати не знайдено."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Currency": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Унікальний ідентифікатор валюти."
          },
          "name": {
            "type": "string",
            "description": "Назва валюти."
          },
          "country": {
            "type": "string",
            "description": "Країна, до якої належить валюта."
          }
        }
      },
      "ExchangeRate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Унікальний ідентифікатор курсу обміну."
          },
          "value": {
            "type": "number",
            "format": "double",
            "description": "Значення курсу обміну."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Дата, до якої відноситься курс обміну."
          },
          "currencyId": {
            "type": "integer",
            "description": "ID валюти, до якої відноситься курс обміну."
          }
        }
      }
    }
  }
}