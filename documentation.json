{
  "openapi": "3.0.0",
  "info": {
    "title": "Currency Exchange Rate API",
    "version": "1.0.0",
    "description": "API для управління валютами, курсами обміну та конвертації валют."
  },
  "paths": {
    "/api/currencies": {
      "get": {
        "summary": "Отримати всі валюти",
        "description": "Повертає список всіх доступних валют у системі.",
        "responses": {
          "200": {
            "description": "Список валют отримано успішно.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Currency" }
                }
              }
            }
          }
        }
      }
    },
    "/api/currencies/{name}": {
      "post": {
        "summary": "Додати нову валюту",
        "description": "Додає нову валюту за вказаним ім'ям, якщо вона ще не існує.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Ім'я нової валюти"
          }
        ],
        "responses": {
          "201": {
            "description": "Валюта створена успішно."
          },
          "400": {
            "description": "Помилка: валюта з таким ім'ям вже існує."
          }
        }
      },
      "delete": {
        "summary": "Видалити валюту за ім'ям",
        "description": "Видаляє валюту та всі пов'язані з нею курси обміну.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Ім'я валюти для видалення"
          }
        ],
        "responses": {
          "204": {
            "description": "Валюта видалена успішно."
          },
          "400": {
            "description": "Помилка: валюта не існує."
          }
        }
      }
    },
    "/api/rates": {
      "get": {
        "summary": "Отримати курси обміну",
        "description": "Повертає всі курси обміну або, якщо вказано валюту та діапазон дат, повертає курси обміну для конкретної валюти.",
        "parameters": [
          {
            "name": "currencyName",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Назва валюти для фільтрації"
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" },
            "description": "Початкова дата для фільтрації курсів"
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" },
            "description": "Кінцева дата для фільтрації курсів"
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 0 },
            "description": "Номер сторінки для пагінації"
          },
          {
            "name": "size",
            "in": "query",
            "schema": { "type": "integer", "default": 10 },
            "description": "Кількість записів на сторінці"
          }
        ],
        "responses": {
          "200": {
            "description": "Список курсів обміну.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ExchangeRate" }
                }
              }
            }
          },
          "400": {
            "description": "Некоректні параметри запиту."
          }
        }
      },
      "post": {
        "summary": "Додати новий курс обміну",
        "description": "Додає курс обміну для конкретної валюти на вказану дату.",
        "parameters": [
          {
            "name": "currencyName",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Назва валюти"
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" },
            "description": "Дата курсу обміну"
          },
          {
            "name": "rate",
            "in": "query",
            "required": true,
            "schema": { "type": "number" },
            "description": "Значення курсу обміну"
          }
        ],
        "responses": {
          "201": {
            "description": "Курс обміну створено."
          },
          "400": {
            "description": "Помилка: курс обміну на цю дату вже існує."
          }
        }
      }
    },
    "/api/rates/today": {
      "get": {
        "summary": "Отримати курси обміну на сьогодні",
        "description": "Повертає список всіх курсів обміну для поточної дати.",
        "responses": {
          "200": {
            "description": "Список курсів обміну на сьогодні.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ExchangeRate" }
                }
              }
            }
          }
        }
      }
    },
    "/api/calculator/convert": {
      "post": {
        "summary": "Конвертація валют",
        "description": "Конвертує суму з однієї валюти в іншу на основі поточних курсів обміну.",
        "parameters": [
          {
            "name": "amount",
            "in": "query",
            "required": true,
            "schema": { "type": "number" },
            "description": "Сума для конвертації"
          },
          {
            "name": "inputCurrency",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Назва валюти, з якої конвертують"
          },
          {
            "name": "outputCurrency",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Назва валюти, в яку конвертують"
          }
        ],
        "responses": {
          "200": {
            "description": "Конвертація виконана успішно.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "inputCurrency": { "type": "string" },
                    "outputCurrency": { "type": "string" },
                    "originalAmount": { "type": "number" },
                    "convertedAmount": { "type": "number" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Помилка: некоректні параметри або відсутній курс обміну для вказаних валют."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Currency": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "ExchangeRate": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "date": { "type": "string", "format": "date" },
          "rate": { "type": "number" }
        }
      }
    }
  }
}