{
  "openapi": "3.0.0",
  "info": {
    "title": "Currency API",
    "version": "1.0.0",
    "description": "API для роботи з валютами та обмінними курсами"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Основний сервер"
    }
  ],
  "paths": {
    "/currencies": {
      "get": {
        "summary": "Отримати всі валюти",
        "operationId": "getAllCurrencies",
        "description": "Ця операція дозволяє отримати список усіх доступних валют у системі.",
        "responses": {
          "200": {
            "description": "Список валют",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Currency"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/currencies/{id}": {
      "get": {
        "summary": "Отримати валюту за ID",
        "operationId": "getCurrencyById",
        "description": "Ця операція дозволяє отримати інформацію про валюту за її ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID валюти"
          }
        ],
        "responses": {
          "200": {
            "description": "Валюта знайдена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Currency"
                }
              }
            }
          },
          "404": {
            "description": "Валюта не знайдена"
          }
        }
      },
      "delete": {
        "summary": "Видалити валюту за ID",
        "operationId": "deleteCurrencyById",
        "description": "Ця операція дозволяє видалити валюту за її ID. Після видалення валюта більше не буде доступна в системі.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID валюти"
          }
        ],
        "responses": {
          "204": {
            "description": "Успішно видалено"
          },
          "404": {
            "description": "Валюта не знайдена"
          },
          "500": {
            "description": "Внутрішня помилка сервера"
          }
        }
      }
    },
    "/currencies/edit/{id}": {
      "put": {
        "summary": "Оновити валюту за ID",
        "operationId": "updateCurrencyById",
        "description": "Ця операція дозволяє оновити інформацію про валюту за її ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID валюти"
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Назва валюти"
          },
          {
            "name": "country",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Країна валюти"
          }
        ],
        "responses": {
          "200": {
            "description": "Валюта оновлена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Currency"
                }
              }
            }
          },
          "400": {
            "description": "Невірний запит"
          }
        }
      }
    },
    "/currenciesByCountry/{country}": {
      "get": {
        "summary": "Отримати валюту за країною",
        "operationId": "getCurrencyByCountry",
        "description": "Ця операція дозволяє отримати валюту, що використовується в певній країні.",
        "parameters": [
          {
            "name": "country",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Країна валюти"
          }
        ],
        "responses": {
          "200": {
            "description": "Валюта знайдена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Currency"
                }
              }
            }
          },
          "404": {
            "description": "Валюта не знайдена"
          }
        }
      }
    },
    "/currencies/{name}/{country}": {
      "post": {
        "summary": "Створити нову валюту",
        "operationId": "createCurrency",
        "description": "Ця операція дозволяє створити нову валюту для певної країни.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Назва валюти"
          },
          {
            "name": "country",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Країна валюти"
          }
        ],
        "responses": {
          "201": {
            "description": "Валюта створена",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "description": "ID створеної валюти"
                }
              }
            }
          },
          "400": {
            "description": "Невірний запит"
          }
        }
      }
    },
    "/rates": {
      "get": {
        "summary": "Отримати всі обмінні курси за датами(фільтрація)",
        "operationId": "getAllExchangeRates",
        "description": "Ця операція дозволяє отримати список усіх обмінних курсів, з можливістю фільтрації за датами та валютою.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "ID валюти для фільтрації"
          },
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Початкова дата для фільтрації"
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Кінцева дата для фільтрації"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Сторінка для пагінації"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Кількість елементів на сторінку"
          }
        ],
        "responses": {
          "200": {
            "description": "Список обмінних курсів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExchangeRate"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Невірний запит"
          }
        }
      },
      "post": {
        "summary": "Створити новий обмінний курс",
        "operationId": "createExchangeRate",
        "description": "Ця операція дозволяє створити новий обмінний курс для валюти на певну дату.",
        "parameters": [
          {
            "name": "currencyName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Назва валюти"
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Дата обміну курсу"
            }
          },
          {
            "name": "rate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "float"
            },
            "description": "Обмінний курс"
          }
        ],
        "responses": {
          "201": {
            "description": "Обмінний курс створено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRate"
                }
              }
            }
          },
          "400": {
            "description": "Невірний запит"
          }
        }
      }
    },
    "/rates/{id}": {
      "get": {
        "summary": "Отримати обмінний курс за ID",
        "operationId": "getExchangeRateById",
        "description": "Ця операція дозволяє отримати обмінний курс за його ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID обмінного курсу"
          }
        ],
        "responses": {
          "200": {
            "description": "Обмінний курс знайдений",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRate"
                }
              }
            }
          },
          "404": {
            "description": "Обмінний курс не знайдений"
          }
        }
      },
      "delete": {
        "summary": "Видалити обмінний курс за ID",
        "operationId": "deleteExchangeRateById",
        "description": "Ця операція дозволяє видалити обмінний курс за його ID. Після видалення обмінний курс більше не буде доступний у системі.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID обмінного курсу"
          }
        ],
        "responses": {
          "204": {
            "description": "Успішно видалено"
          },
          "404": {
            "description": "Обмінний курс не знайдений"
          },
          "500": {
            "description": "Внутрішня помилка сервера"
          }
        }
      },
      "put": {
        "summary": "Оновити обмінний курс за ID",
        "operationId": "updateExchangeRateById",
        "description": "Ця операція дозволяє оновити обмінний курс для валюти за її ID. Потрібно вказати нову дату та курс.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID обмінного курсу"
          },
          {
            "name": "currencyName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Назва валюти для оновлення"
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Нова дата для обмінного курсу"
          },
          {
            "name": "rate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "description": "Новий обмінний курс"
          }
        ],
        "responses": {
          "200": {
            "description": "Обмінний курс оновлений",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRate"
                }
              }
            }
          },
          "400": {
            "description": "Невірний запит"
          },
          "404": {
            "description": "Обмінний курс не знайдений"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Currency": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID валюти"
          },
          "name": {
            "type": "string",
            "description": "Назва валюти"
          },
          "country": {
            "type": "string",
            "description": "Країна, до якої належить валюта"
          }
        }
      },
      "ExchangeRate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID обмінного курсу"
          },
          "currencyName": {
            "type": "string",
            "description": "Назва валюти"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Дата обміну курсу"
          },
          "rate": {
            "type": "number",
            "format": "float",
            "description": "Обмінний курс"
          }
        }
      }
    }
  }
}
