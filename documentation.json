{
  "openapi": "3.0.0",
  "info": {
    "title": "Currency Exchange API",
    "version": "1.0.0",
    "description": "API для керування валютами, обмінними курсами і конвертації валют."
  },
  "paths": {
    "/api/currencies": {
      "get": {
        "summary": "Отримати список всіх валют",
        "operationId": "getAllCurrencies",
        "responses": {
          "200": {
            "description": "Список всіх валют",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Currency" }
                }
              }
            }
          }
        }
      }
    },
    "/api/currencies/{name}": {
      "post": {
        "summary": "Створити нову валюту",
        "operationId": "createCurrency",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "201": { "description": "Валюта створена" },
          "400": { "description": "Помилка: валюта вже існує" }
        }
      },
      "delete": {
        "summary": "Видалити валюту",
        "operationId": "deleteCurrency",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Валюта видалена" },
          "400": { "description": "Помилка: валюта не знайдена" }
        }
      }
    },
    "/api/rates": {
      "get": {
        "summary": "Отримати список обмінних курсів",
        "operationId": "getAllExchangeRates",
        "parameters": [
          { "name": "currencyName", "in": "query", "schema": { "type": "string" } },
          { "name": "startDate", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "endDate", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Список обмінних курсів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ExchangeRate" }
                }
              }
            }
          },
          "400": { "description": "Помилка: некоректні параметри" }
        }
      },
      "post": {
        "summary": "Створити новий обмінний курс",
        "operationId": "createExchangeRate",
        "parameters": [
          { "name": "currencyName", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "date", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "rate", "in": "query", "required": true, "schema": { "type": "number" } }
        ],
        "responses": {
          "201": { "description": "Обмінний курс створений" },
          "400": { "description": "Помилка: обмінний курс вже існує" }
        }
      },
      "put": {
        "summary": "Оновити обмінний курс",
        "operationId": "updateExchangeRate",
        "parameters": [
          { "name": "currencyName", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "date", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "rate", "in": "query", "required": true, "schema": { "type": "number" } }
        ],
        "responses": {
          "200": { "description": "Обмінний курс оновлено" },
          "400": { "description": "Помилка: обмінний курс не знайдено" }
        }
      }
    },
    "/api/rates/today": {
      "get": {
        "summary": "Отримати обмінні курси на поточний день",
        "operationId": "getRatesForToday",
        "responses": {
          "200": {
            "description": "Список обмінних курсів на поточний день",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ExchangeRate" }
                }
              }
            }
          }
        }
      }
    },
    "/api/rates/{currencyName}": {
      "delete": {
        "summary": "Видалити обмінні курси за назвою валюти",
        "operationId": "deleteRatesByCurrencyName",
        "parameters": [
          {
            "name": "currencyName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Обмінні курси видалені" },
          "400": { "description": "Помилка: валюта не знайдена" }
        }
      }
    },
    "/api/calculator/convert": {
      "post": {
        "summary": "Конвертувати валюту",
        "operationId": "convertCurrency",
        "parameters": [
          { "name": "amount", "in": "query", "required": true, "schema": { "type": "number" } },
          { "name": "inputCurrency", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "outputCurrency", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Сума після конвертації",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "inputCurrency": { "type": "string" },
                    "outputCurrency": { "type": "string" },
                    "originalAmount": { "type": "number" },
                    "convertedAmount": { "type": "number" }
                  }
                }
              }
            }
          },
          "400": { "description": "Помилка: невірні дані" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Currency": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "ExchangeRate": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "date": { "type": "string", "format": "date" },
          "rate": { "type": "number" }
        }
      }
    }
  }
}